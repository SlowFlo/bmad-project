# Ex Aequo — variables d'environnement.
# Les clés sont documentées ici SANS leurs valeurs : jamais de secret en dépôt.
# Copier ce fichier en `.env` et renseigner ce dont le lot en cours a besoin.

# --- Base de données -------------------------------------------------------
# URL SQLAlchemy de la base SQLite, un fichier à côté du dépôt.
# Défaut si absent : sqlite:///exaequo.db
EXAEQUO_BASE=

# --- Modèle (E3) -----------------------------------------------------------
# Clé d'API Anthropic. Aucune dépendance au SDK n'est encore installée.
ANTHROPIC_API_KEY=

# --- Qualité de l'air (E7) -------------------------------------------------
# Identifiant d'accès à l'API Atmo Auvergne-Rhône-Alpes : gratuit, sur inscription.
# Open-Meteo et Data ES s'appellent anonymement et n'ont pas de clé.
ATMO_AURA_IDENTIFIANT=
ATMO_AURA_MOT_DE_PASSE=

# --- OAuth agenda (E8) -----------------------------------------------------
# Autorisation incrémentale (AD-18) : identité et adresse d'abord, écriture agenda
# au second consentement. Redirection sur http://localhost:<port>.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
