# Sortie du serveur MCP playwright — instantanés de page et logs de console,
# régénérés à chaque session et sans rapport avec le projet.
.playwright-mcp/

# Captures de session hors projet
todomvc-3-items.png

# Réglages personnels de Claude Code
.claude/settings.local.json

# Environnement Python et artefacts d'exécution
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Base SQLite locale — un fichier à côté du dépôt, jamais en dépôt
*.db

# Secrets : `.env.example` documente les clés, `.env` les porte
.env
